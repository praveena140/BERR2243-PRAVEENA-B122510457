    {
        "id": "mqtt_in_node",
        "type": "mqtt in",
        "z": "flow_iot_pipeline",
        "name": "Receive Postman Telemetry",
        "topic": "device/telemetry",
        "qos": "1",
        "datatype": "json",
        "broker": "emqx_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 170,
        "y": 140,
        "wires": [
            [
                "prep_query_node"
            ]
        ]
    },
    {
        "id": "prep_query_node",
        "type": "function",
        "z": "flow_iot_pipeline",
        "name": "Prepare DB Query",
        "func": "// Store the original incoming sensor data so it doesn't get overwritten\nmsg.sensorData = msg.payload;\n\n// 1. Save original incoming sensor payload from MQTT\nmsg.sensorData = msg.payload;\n\n// 2. Set the exact query filter for the findOne operation\nmsg.payload = { \n    \"deviceId\": msg.sensorData.deviceId, \n    \"authorized\": true \n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 140,
        "wires": [
            [
                "c2cd3baffd752026"
            ]
        ]
    },
    {
        "id": "check_auth_node",
        "type": "switch",
        "z": "flow_iot_pipeline",
        "name": "Is Authorized?",
        "property": "payload",
        "propertyType": "jsonata",
        "rules": [
            {
                "t": "eq",
                "v": "true",
                "vt": "jsonata"
            },
            {
                "t": "null"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 240,
        "y": 240,
        "wires": [
            [
                "stamp_payload_node"
            ],
            [
                "unauthorized_log"
            ]
        ]
    },
    {
        "id": "unauthorized_log",
        "type": "debug",
        "z": "flow_iot_pipeline",
        "name": "ACCESS DENIED LOG",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "\"Device Rejected! Not registered in metadata.\"",
        "targetType": "jsonata",
        "statusVal": "",
        "statusType": "auto",
        "x": 530,
        "y": 280,
        "wires": []
    },
    {
        "id": "stamp_payload_node",
        "type": "function",
        "z": "flow_iot_pipeline",
        "name": "Format Time-Series Data",
        "func": "// Extract the backed-up raw sensor object\nvar rawSensor = msg.sensorData;\n\n// If it arrived as a text string, parse it into an object\nif (typeof rawSensor === 'string') {\n    rawSensor = JSON.parse(rawSensor);\n}\n\n// Format the complete document structure for your Atlas collection\nmsg.payload = {\n    deviceId: rawSensor.deviceId || \"unknown_device\",\n    temperature: rawSensor.temperature,\n    humidity: rawSensor.humidity,\n    timestamp: new Date()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 220,
        "wires": [
            [
                "1962f99491f2a31c"
            ]
        ]
    },
    {
        "id": "authorized_debug",
        "type": "debug",
        "z": "flow_iot_pipeline",
        "name": "SUCCESS LOG",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "\"Pipeline Authorized: Saved telemetry to Atlas Time-Series!\"",
        "targetType": "jsonata",
        "statusVal": "",
        "statusType": "auto",
        "x": 920,
        "y": 220,
        "wires": []
    },
